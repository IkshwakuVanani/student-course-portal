{
  "name": "ikshwakuvanani/student-course-portal",
  "description": "A simple Laravel-based student course portal",
  "type": "project",
  "require": {
    "php": "^8.0",
    "laravel/framework": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  }
}
